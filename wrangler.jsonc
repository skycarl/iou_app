{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "iou-app",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-08",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "iou-app",
      "database_id": "TBD",
      "migrations_dir": "migrations"
    }
  ]
}
